# Dependencies
node_modules/
.pnpm-store/

# Build output. `dist-cjs/` needs its own line: `dist/` does not match it, and the
# contracts package's CommonJS build would otherwise be committed with every rebuild.
dist/
dist-cjs/
*.tsbuildinfo
.tsbuildinfo

# Test output
coverage/
test-results/
playwright-report/

# Environment. Only the committed templates are allowed through.
.env
.env.*
*.env
!.env.example
!**/.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
pnpm-debug.log*
*.stackdump
