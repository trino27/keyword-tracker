root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# be/ and packages/ use 2 spaces, fe/ uses tabs — each workspace's .prettierrc is
# the authority; these only set the editor's default before prettier runs.
[{be,packages}/**]
indent_style = space
indent_size = 2

[fe/**]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
