# Copy to `.env` (git-ignored) and adjust. Read by docker compose and by the local
# `pnpm dev:*` / `pnpm db:*` scripts. Placeholder values only — never commit a real secret.

# Postgres (the compose service and the local tools). Published on 55433, not 5432, so it
# never collides with a Postgres already installed on the host.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seo_tracker
POSTGRES_PORT=55433

# The backend outside docker reaches Postgres on the published port.
# Inside docker compose builds its own URL from the values above.
DATABASE_URL=postgresql://tracker:change-me@localhost:55433/seo_tracker

# Database tests use their own database; the runner refuses any name not ending in _test.
TEST_DATABASE_URL=postgresql://tracker:change-me@localhost:55433/seo_tracker_test

# `pnpm dev:be` also executes queued crawls. Tests force it off and drive runs themselves.
CRAWL_WORKER_ENABLED=true

# The password of both seeded demo accounts (see the README). A demo value: change it
# anywhere the app is reachable by others.
SEED_USER_PASSWORD=demo-password-change-me

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# The port Caddy publishes: the app is at http://localhost:8080
WEB_PORT=8080
